---
const { event, variant = 'full' } = Astro.props;
const { name, date, time, location, type, description } = event.data;

const isSlim = variant === 'slim';

const formattedDate = new Date(date).toLocaleDateString('en-GB', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const typeColors = {
  concert:
    'text-orchard-terracotta-dark border-orchard-terracotta/20 bg-orchard-terracotta-light/10',
  rehearsal:
    'text-wealden-green-dark border-wealden-green/20 bg-wealden-green-light/10',
  'play day':
    'text-bluebell-haze-dark border-bluebell-haze/20 bg-bluebell-haze-light/10',
  other: 'text-knole-ink border-knole-ink/20 bg-downs-chalk',
};
---

<div
  class:list={[
    'flex flex-col overflow-hidden bg-white border border-knole-ink/5 transition-all duration-500 hover:shadow-2xl hover:shadow-knole-ink/5 hover:-translate-y-2 group rounded-3xl',
    isSlim ? 'h-full' : '',
  ]}
>
  <div class:list={[isSlim ? 'p-8' : 'p-10']}>
    <div
      class:list={['flex items-center justify-between', isSlim ? 'mb-6' : 'mb-10']}
    >
      <span
        class:list={[
          'inline-flex items-center px-4 py-1.5 text-[10px] font-bold uppercase tracking-[0.25em] rounded-full border',
          typeColors[type] || typeColors.other,
        ]}
      >
        {type}
      </span>
      <span
        class="text-xs font-bold text-knole-ink/70 uppercase tracking-[0.2em]"
      >
        {time}
      </span>
    </div>

    <div class:list={[isSlim ? 'space-y-4' : 'space-y-6']}>
      <p
        class="text-xs font-bold text-wealden-green uppercase tracking-[0.25em]"
      >
        {formattedDate}
      </p>

      <h3
        class:list={[
          'font-serif font-normal text-knole-ink group-hover:text-orchard-terracotta transition-colors duration-500 leading-[1.2]',
          isSlim ? 'text-2xl md:text-3xl' : 'text-3xl md:text-4xl',
        ]}
      >
        <a href={`/events/${event.id}`} class="block focus:outline-none focus:underline decoration-orchard-terracotta decoration-2 underline-offset-8">
          {name}
        </a>
      </h3>

      {!isSlim && (
        <>
          <p class="text-base text-knole-ink/70 font-medium leading-relaxed italic border-l-2 border-downs-chalk pl-4">
            {location}
          </p>

          <p class="text-knole-ink/80 line-clamp-3 leading-relaxed text-lg">
            {description}
          </p>
        </>
      )}
    </div>
  </div>

  {!isSlim && (
    <div class="px-10 pb-10 mt-auto">
      <a
        href={`/events/${event.id}`}
        class="group/btn inline-flex items-center gap-3 text-[11px] font-bold text-knole-ink uppercase tracking-[0.25em] transition-all focus:outline-none"
        aria-label={`Explore details for ${name}`}
      >
        <span class="relative pb-1 after:absolute after:bottom-0 after:left-0 after:h-[2px] after:w-full after:bg-orchard-terracotta after:origin-right after:scale-x-0 group-hover/btn:after:scale-x-100 group-hover/btn:after:origin-left group-focus/btn:after:scale-x-100 group-focus/btn:after:origin-left after:transition-transform after:duration-500">
          Explore Event
        </span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4 text-orchard-terracotta transition-transform duration-500 group-hover/btn:translate-x-2"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2.5"
            d="M17 8l4 4m0 0l-4 4m4-4H3"
          />
        </svg>
      </a>
    </div>
  )}
</div>
