/*
  Security Headers for Sevenoaks Saxes
*/

/* Apply to all paths */
/* We don't have a content-security-policy-report-only header here as it's better to start with standard headers */
/* Cloudflare automatically handles some of these if enabled in the dashboard, but explicitly setting them is safer */

/*
  CSP Note: This is a relatively strict CSP.
  - Allows scripts from self and Google Fonts.
  - Allows styles from self and Google Fonts.
  - Allows images from self and data: (for the noise texture).
  - Allows connect-src for standard analytics if added later.
*/

/
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self';
